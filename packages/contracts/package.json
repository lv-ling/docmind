{
  "name": "@docmind/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "generated",
    "openapi",
    "json-schema",
    "events"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi": {
      "types": "./generated/openapi.d.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi/v1.yaml --output ./generated/openapi.d.ts",
    "build": "pnpm run generate && tsc --project tsconfig.build.json",
    "dev": "pnpm run generate && tsc --project tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run generate && tsc --project tsconfig.json --noEmit",
    "test": "pnpm run generate && vitest run --root ../.. packages/contracts/src"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
