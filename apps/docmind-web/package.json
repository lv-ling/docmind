{
  "name": "docmind-web",
  "version": "0.1.0",
  "private": true,
  "description": "DocMind Vue web application",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "lucide-vue-next": "1.0.0",
    "parse5": "8.0.1",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/server-renderer": "3.5.40",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
