{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docmind.local/schemas/model-extraction-output.schema.json",
  "title": "ModelExtractionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "fields"],
  "properties": {
    "data": {
      "type": "object"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value", "confidence", "evidence", "candidates", "needs_review"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "value": true,
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node_id", "page_number", "tokenized_text"],
              "properties": {
                "node_id": { "type": "string", "minLength": 1 },
                "page_number": { "type": ["integer", "null"], "minimum": 1 },
                "tokenized_text": { "type": "string" }
              }
            }
          },
          "candidates": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "confidence", "evidence"],
              "properties": {
                "value": true,
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["node_id", "page_number", "tokenized_text"],
                    "properties": {
                      "node_id": { "type": "string", "minLength": 1 },
                      "page_number": { "type": ["integer", "null"], "minimum": 1 },
                      "tokenized_text": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "needs_review": { "type": "boolean" }
        }
      }
    }
  }
}
