DOCMIND_AI_ENVIRONMENT=local
DOCMIND_AI_HOST=127.0.0.1
DOCMIND_AI_PORT=8090
DOCMIND_AI_LOG_LEVEL=INFO
DOCMIND_AI_INTERNAL_TOKEN=local-only-docmind-document-ai-token-change-before-production
DOCMIND_AI_DOCS_ENABLED=true
DOCMIND_AI_MAX_DOCUMENT_BYTES=10485760
DOCMIND_AI_MAX_PDF_PAGES=500
DOCMIND_AI_LIBREOFFICE_BINARY=libreoffice
DOCMIND_AI_CONVERSION_TIMEOUT_SECONDS=30
DOCMIND_AI_MAX_CONVERSION_OUTPUT_BYTES=26214400
DOCMIND_AI_MAX_SENSITIVE_TEXT_CHARACTERS=5000000
DOCMIND_AI_EXTRACTION_PROVIDER_TIMEOUT_SECONDS=30
DOCMIND_AI_EXTRACTION_TOTAL_TIMEOUT_SECONDS=45
DOCMIND_AI_EXTRACTION_RETRY_ATTEMPTS=2
DOCMIND_AI_EXTRACTION_RETRY_BACKOFF_SECONDS=0.05
DOCMIND_AI_EXTRACTION_INPUT_TOKEN_BUDGET=50000
DOCMIND_AI_EXTRACTION_OUTPUT_TOKEN_BUDGET=10000
