{
  "name": "@docmind/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --root ../.. apps/web/src"
  },
  "dependencies": {
    "@docmind/contracts": "workspace:*",
    "@docmind/editor": "workspace:*",
    "@docmind/ui": "workspace:*",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.1",
    "vite": "8.1.5",
    "vue-tsc": "3.3.8"
  }
}
