# Local development defaults. Copy to deploy/compose/.env when customization is needed.
DOCMIND_POSTGRES_DB=docmind
DOCMIND_POSTGRES_USER=docmind
DOCMIND_POSTGRES_PASSWORD=12345678
DOCMIND_POSTGRES_PORT=5432
DOCMIND_REDIS_PASSWORD=12345678
DOCMIND_REDIS_PORT=6379
DOCMIND_RABBITMQ_USER=docmind
DOCMIND_RABBITMQ_PASSWORD=12345678
DOCMIND_RABBITMQ_PORT=5672
DOCMIND_RABBITMQ_MANAGEMENT_PORT=15672
DOCMIND_MINIO_USER=minioadmin
DOCMIND_MINIO_PASSWORD=12345678
DOCMIND_MINIO_API_PORT=9000
DOCMIND_MINIO_CONSOLE_PORT=9001
# ONLYOFFICE 是可选的原生 DOCX 编辑 POC；使用 `infra.sh editor-start` 启动。
DOCMIND_ONLYOFFICE_PORT=8082
# 仅为本地示例。共享测试/生产环境必须从 Secret 管理注入随机高强度密钥。
DOCMIND_ONLYOFFICE_JWT_SECRET=local-only-docmind-onlyoffice-jwt-secret-change-before-production
DOCMIND_ONLYOFFICE_JWT_HEADER=AuthorizationJwt
# Mount only fonts that your organization is licensed to use. On macOS POC machines,
# /System/Library/Fonts supplies the system fonts without copying them into this repo.
DOCMIND_ONLYOFFICE_FONT_DIR=../onlyoffice/fonts
